# Vercel Postgres — copied automatically when you link a Vercel Postgres database
# Find these in: Vercel Dashboard → Storage → your database → Connect tab
POSTGRES_PRISMA_URL="postgresql://user:password@host/dbname?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host/dbname?connect_timeout=15"

# Auth — any long random string
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Your deployed URL (update after first deploy)
NEXTAUTH_URL="https://your-app.vercel.app"
