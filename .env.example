# Vercel Postgres — these are automatically set when you link a Vercel Postgres database
# in your Vercel project dashboard (Storage tab). Copy them here for local dev.
POSTGRES_PRISMA_URL="postgresql://user:password@host/dbname?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://user:password@host/dbname?connect_timeout=15"

# Auth — set NEXTAUTH_SECRET to any long random string
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
